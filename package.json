{
  "name": "salon-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Salon and nail studio management for Shruti Pahwa Luxury Salon & Academy",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check": "tsc --noEmit && tsx scripts/check-structure.ts",
    "test:api": "tsx scripts/test-api.ts",
    "reset-2fa": "tsx scripts/reset-2fa.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "setup:fresh": "prisma db push --force-reset && tsx prisma/seed.ts --empty --reset",
    "setup:demo": "prisma db push --force-reset && tsx prisma/seed.ts --reset"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "html-to-image": "1.11.11",
    "jspdf": "2.5.2",
    "lucide-react": "0.453.0",
    "next": "14.2.35",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "author": "Salon Studio <nitish.ripenapps@gmail.com>"
}
