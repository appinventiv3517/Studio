# MongoDB replica set. Local Docker (docker compose up -d), or your Atlas connection string with a database name:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/salon?retryWrites=true&w=majority
DATABASE_URL="mongodb://127.0.0.1:27017/salon?replicaSet=rs0&directConnection=true"
# Any long random string. Used to sign login sessions.
SESSION_SECRET="change-me-to-a-long-random-string"
# Websites on other domains allowed to call the API from a browser, comma separated. Leave empty for none.
# ALLOWED_ORIGINS="https://book.example.com"
# The public address of this app (no trailing slash). Used for the preview image when the link is shared.
# SITE_URL="https://salon.example.com"

# --- Live deployment only (see deploy/README.md) ---
# Website on Vercel: where the backend (Render) is. Unset everywhere else.
# API_URL="https://salon-studio-api.onrender.com"
